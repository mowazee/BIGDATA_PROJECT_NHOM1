    {
      "title": "Ti le san pham theo phan khuc gia",
      "text": "%hive\nSELECT CASE WHEN sale_price \u003c 7000000 THEN \u00271. Gia re (\u003c7tr)\u0027 WHEN sale_price \u003c\u003d 15000000 THEN \u00272. Tam trung (7-15tr)\u0027 WHEN sale_price \u003c\u003d 25000000 THEN \u00273. Can cao cap (15-25tr)\u0027 ELSE \u00274. Cao cap (\u003e25tr)\u0027 END AS phan_khuc, COUNT(*) AS so_luong FROM products_hive GROUP BY CASE WHEN sale_price \u003c 7000000 THEN \u00271. Gia re (\u003c7tr)\u0027 WHEN sale_price \u003c\u003d 15000000 THEN \u00272. Tam trung (7-15tr)\u0027 WHEN sale_price \u003c\u003d 25000000 THEN \u00273. Can cao cap (15-25tr)\u0027 ELSE \u00274. Cao cap (\u003e25tr)\u0027 END",
      "user": "anonymous",
